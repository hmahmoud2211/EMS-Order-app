# ---------------------------------------------------------------------------
# EMS Food — environment configuration (copy to .env and fill in real values)
# Never commit .env. The mobile app never receives any of these secrets.
# ---------------------------------------------------------------------------

# Runtime
# development | test | production
APP_ENV=production
LOG_LEVEL=INFO
LOG_JSON=true

# Public HTTPS domain served by Caddy (DNS A record must point to the VPS)
API_DOMAIN=food.example.com
ACME_EMAIL=it@example.com

# PostgreSQL (used by docker-compose to build DATABASE_URL)
POSTGRES_DB=ems_food
POSTGRES_USER=ems
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# For running the backend outside Docker:
# DATABASE_URL=postgresql+psycopg://ems:PASSWORD@localhost:5432/ems_food

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
RATE_LIMIT_ENABLED=true

# Origins allowed to call the API from a browser (Expo Web admin)
CORS_ORIGINS=https://food.example.com

# Business rules
BUSINESS_TIMEZONE=Africa/Cairo
CURRENCY=EGP

# Uploads
MAX_IMAGE_UPLOAD_MB=8
MAX_MENU_UPLOAD_MB=20

# OCR (Tesseract is installed in the Docker image)
OCR_LANGUAGES=eng+ara

# Push notifications via the free Expo Push Service
PUSH_ENABLED=true
# Optional: only needed if you enable "enhanced push security" in your Expo account
EXPO_ACCESS_TOKEN=

# Optional SMTP — emails password-reset codes. Without it, admins issue codes in the app.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Optional authorized Talabat partner integration (disabled unless ALL are set
# AND you hold official partner authorization). See docs/restaurant-imports.md.
TALABAT_INTEGRATION_ENABLED=false
TALABAT_API_BASE_URL=
TALABAT_CLIENT_ID=
TALABAT_CLIENT_SECRET=
