{
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# API and uploaded images
	handle /api/* {
		request_body {
			max_size 25MB
		}
		reverse_proxy api:8000
	}
	handle /media/* {
		reverse_proxy api:8000
	}

	# Expo Web build (admin in the browser) — single-page app fallback
	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}
}
