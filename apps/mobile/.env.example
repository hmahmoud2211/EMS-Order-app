# Mobile/web client configuration. Only EXPO_PUBLIC_* values are bundled into the app —
# never put secrets here.

# API base URL. Production must be HTTPS. Leave unset in development to use the
# machine running `expo start` (port 8000).
EXPO_PUBLIC_API_URL=https://food.example.com/api/v1

# EAS project id (created by `npx eas-cli@latest init`) — required for push notifications.
EAS_PROJECT_ID=

# Path to google-services.json for Android push (Firebase Cloud Messaging), used at build time.
GOOGLE_SERVICES_JSON=
